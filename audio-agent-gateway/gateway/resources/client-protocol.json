      "event_id",
      "request_event_id"
    ],
    "additionalProperties": {}
  },
  "GatewayTaskCreateSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "task.create"
      },
      "event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "request_event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "occurred_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "message": {
        "type": "object",
        "properties": {
          "parts": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "file"
                    },
                    "mime": {
                      "type": "string",
                      "minLength": 3
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "mime",
                    "url"
                  ],
                  "additionalProperties": {}
                }
              ]
            }
          }
        },
        "required": [
          "parts"
        ]
      }
    },
    "required": [
      "type",
      "event_id",
      "message"
    ],
    "additionalProperties": {}
  },
