{
  "GatewayClientEnvelopeSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "request_event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "occurred_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "type",
      "event_id"
    ],
    "additionalProperties": {}
  },
  "GatewaySessionHelloSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "session.hello"
      },
      "event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "request_event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "occurred_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "protocol": {
        "type": "object",
        "properties": {
          "min": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "max": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "min",
          "max"
        ]
      },
      "client": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "type",
          "instance_id"
        ]
      },
      "capabilities": {
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        }
      },
      "tools": {
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "inputSchema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "object"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": {}
            },
            "response_on_success": {
              "type": "string",
              "enum": [
                "auto",
                "none"
              ]
            }
          },
          "required": [
            "name",
            "description",
            "inputSchema"
          ],
          "additionalProperties": false
        }
      },
      "locale": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      },
      "time_zone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "connection": {
        "type": "object",
        "properties": {
          "voice_enabled": {
            "type": "boolean"
          },
          "input_enabled": {
            "type": "boolean"
          },
          "output_enabled": {
            "type": "boolean"
          },
          "text_only": {
            "type": "boolean"
          },
          "wake_word_only": {
            "type": "boolean"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "output_voice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "working_directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "client_states": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "takeover": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "type",
      "event_id",
      "protocol",
      "client",
      "capabilities"
    ],
    "additionalProperties": {}
  },
  "GatewaySessionPongSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
