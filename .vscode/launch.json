{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portal Desktop：Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start -- --inspect-electron",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "env": {
        "PORTAL_DESKTOP_GATEWAY_URL": "http://127.0.0.1:3102"
      }
    }
  ]
}
