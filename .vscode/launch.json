{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portal Desktop：编译并运行",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start -- --inspect-electron",
      "windows": {
        "command": "npm.cmd start -- --inspect-electron"
      },
      "cwd": "${workspaceFolder}",
      "env": {
        "PORTAL_DESKTOP_USER_DATA": "${workspaceFolder}/output/vscode-profile"
      }
    }
  ]
}
